# Copy this file to `.env` and fill in your key:
#
#   cp .env.TEMPLATE .env
#
# Docker Compose automatically loads `.env` from this directory, so
# `docker compose up` will pick up the value below. `.env` is gitignored.

# REQUIRED. Use an Ingest API key from a Honeycomb environment (a free team
# works — see the README). This single key is used to:
#   - send the generated traces through Refinery to your environment, and
#   - let Refinery send its own metrics ("Refinery Metrics") and logs
#     ("Refinery Logs") to the same environment.
# `docker compose up` fails fast if this is empty.
HONEYCOMB_API_KEY=
