# Copy this file to `.env` and fill in your key:
#
#   cp .env.TEMPLATE .env
#
# Docker Compose automatically loads `.env` from this directory, so
# `docker compose up` will pick up the value below. `.env` is gitignored.

# Optional. Reused by Refinery to forward kept traces upstream. The exercise's
# memory pressure (trace assembly) reproduces even without a valid key, so you
# can leave this blank for a pure crash test.
HONEYCOMB_API_KEY=
